<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The core reaches the relay; the app reaches the core on 127.0.0.1. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notices the app shows itself (Android 13+ asks): from its own connection. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The connection service (connection/ConnectionService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".AideApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aide">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A photo taken for a message (工单 #91): the camera app writes it here, then the composer reads it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attach"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attach_paths" />
        </provider>
        <!-- Keeps the relay connection in the background, so notices reach the phone
             without a push service (docs/android-app.md §4). No other foreground
             service type fits a connection the app holds to its own server; dataSync
             is limited to 6 hours a day from Android 15. -->
        <service
            android:name=".connection.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds the connection to the owner's own Aide relay so that requests needing the owner (an agent's question, a request to connect) reach this phone as notifications; the phone has no push service." />
        </service>
    </application>
</manifest>
