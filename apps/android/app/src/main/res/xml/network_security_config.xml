<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks to its own core (LocalService) on the loopback interface,
     in plain HTTP with a bearer token made at each launch, as the iPhone
     app does. Everything else stays HTTPS-only; the core's own connections
     to the relay are Go's, not the app's. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
