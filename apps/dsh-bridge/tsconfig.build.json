{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
